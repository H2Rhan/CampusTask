# ---- App ----
APP_NAME=CampusTask
APP_ENV=dev
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Database ----
# 本地开发默认 SQLite；生产使用 MySQL：
# DATABASE_URL=mysql+pymysql://campustask:campustask@mysql:3306/campustask?charset=utf8mb4
DATABASE_URL=sqlite:///./campustask.db

# ---- Redis（聊天室在线状态 / 缓存，可选） ----
REDIS_URL=redis://redis:6379/0

# ---- Platform ----
# 撮合服务费率（比赛 Demo 默认 0，商业模式展示可调为 0.05）
PLATFORM_FEE_RATE=0.0
# 新用户初始信用分
INITIAL_CREDIT_SCORE=100

# ---- LLM（AI 任务解析，OpenAI 兼容接口；不配置则自动使用内置规则引擎） ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
