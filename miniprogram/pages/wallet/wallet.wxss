.wallet-hero {
  background: linear-gradient(135deg, #165dff, #4080ff);
  color: #fff;
  padding: 60rpx 32rpx;
}
.wallet-hero .lbl { font-size: 24rpx; opacity: 0.8; }
.wallet-hero .num { font-size: 72rpx; font-weight: 700; margin: 12rpx 0; }
.wallet-hero .frozen { font-size: 24rpx; opacity: 0.8; }
.section-title { font-weight: 600; margin-bottom: 20rpx; }
.quick-amounts { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.qa {
  flex: 1;
  text-align: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx 0;
  color: #165dff;
  font-weight: 600;
}
.amount-input { background: #f7f8fa; border-radius: 12rpx; padding: 20rpx; margin-bottom: 24rpx; }
.hint { text-align: center; color: #86909c; font-size: 22rpx; margin-top: 16rpx; }
