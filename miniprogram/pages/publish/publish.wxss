.ai-box { border: 2rpx solid #e8f0ff; }
.ai-title { font-weight: 600; margin-bottom: 16rpx; color: #165dff; }
.ai-input {
  width: 100%;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  min-height: 120rpx;
  box-sizing: border-box;
}
.ai-btn { margin-top: 20rpx; }
.section-title { font-weight: 600; margin-bottom: 20rpx; }
.missing { color: #ff7d00; font-size: 24rpx; margin-bottom: 16rpx; }
.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.field.required .label::after { content: ' *'; color: #f53f3f; }
.label { width: 160rpx; color: #4e5969; }
.field input { flex: 1; }
.picker { flex: 1; color: #1d2129; }
.publish-btn { margin-top: 32rpx; }
.hint { text-align: center; color: #86909c; font-size: 22rpx; margin-top: 16rpx; }
