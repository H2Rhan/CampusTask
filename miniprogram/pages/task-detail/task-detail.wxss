.hero { text-align: center; }
.status-badge {
  display: inline-block;
  padding: 6rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background: #e8f0ff;
  color: #165dff;
  margin-bottom: 16rpx;
}
.status-SETTLED { background: #e8ffea; color: #00b42a; }
.status-ARBITRATING { background: #fff3e8; color: #ff7d00; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 12rpx; }
.route { color: #4e5969; margin-bottom: 12rpx; }
.meta-row { display: flex; justify-content: center; gap: 32rpx; align-items: center; }
.price.big { font-size: 40rpx; }
.match { margin-top: 12rpx; color: #00b42a; font-size: 24rpx; }
.section-title { font-weight: 600; margin-bottom: 12rpx; }
.desc { color: #4e5969; line-height: 1.6; }
.actions { margin: 24rpx; }
.actions .btn-primary { margin-bottom: 20rpx; }
.btn-chat { background: #00b42a; color: #fff; border-radius: 44rpx; margin-bottom: 20rpx; }
.action-row { display: flex; gap: 20rpx; }
.btn-ghost { background: #f2f3f5; color: #4e5969; border-radius: 44rpx; flex: 1; font-size: 28rpx; }
.btn-ghost.warn { color: #ff7d00; }
.review-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex; align-items: center; justify-content: center;
}
.review-card { background: #fff; border-radius: 24rpx; padding: 40rpx; width: 80%; }
.stars { text-align: center; margin: 20rpx 0; }
.star { font-size: 56rpx; color: #e5e6eb; margin: 0 8rpx; }
.star.on { color: #ffb400; }
.review-input { background: #f7f8fa; border-radius: 12rpx; padding: 20rpx; width: 100%; box-sizing: border-box; margin-bottom: 20rpx; }
