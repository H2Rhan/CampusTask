.header {
  background: linear-gradient(135deg, #165dff, #4080ff);
  padding: 32rpx 32rpx 0;
  color: #fff;
}
.campus { font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }
.tabs { display: flex; }
.tab {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  border-bottom: 4rpx solid transparent;
}
.tab.active { color: #fff; border-bottom-color: #fff; font-weight: 600; }
.badge {
  background: #f53f3f;
  border-radius: 20rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  margin-left: 8rpx;
}
.task-card { position: relative; }
.task-head { display: flex; align-items: center; margin-bottom: 12rpx; }
.title { font-weight: 600; flex: 1; margin-right: 16rpx; }
.route { color: #4e5969; margin-bottom: 12rpx; }
.meta { display: flex; justify-content: space-between; align-items: center; }
.empty { text-align: center; color: #86909c; padding: 120rpx 0; }
